    "mono": "'SF Mono', ui-monospace, monospace",
    "weights": { "regular": 400, "medium": 500 },
    "size": { "title": 24, "body": 14, "label": 13, "caption": 12 },
    "trackingPoints": -0.15
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32 },
  "radius": {
    "navigation": 8,
    "control": 8,
    "card": 16
  },
  "icon": { "navigation": 14, "card": 20 },
  "shape": { "primaryCTA": "capsule" },
  "motion": {
    "mainWindow": {
      "hoverSeconds": 0.15,
      "pressSeconds": 0.1,
      "pressedOffsetY": 1,
      "pressedOpacity": 0.92,
      "disabledOpacity": 0.48,
      "spring": { "response": 0.2, "dampingFraction": 1.0, "blendDuration": 0 }
    },
    "momentumSpring": { "response": 0.36, "dampingFraction": 0.82 },
    "hudProtectedBaseline": {
      "surface": { "mass": 0.9, "stiffness": 420, "damping": 36 },
      "crossfade": { "mass": 0.8, "stiffness": 260, "damping": 34 },
      "processingSeconds": 0.08,
      "controlDisclosureSeconds": 0.2,
      "controlOpacitySeconds": 0.1,
      "behaviorChanged": false
    },
    "mark": {
      "cursorBlinkSeconds": 1.05,
      "cursorBlinkCurve": "step",
      "baselineDrawSeconds": 1.2,
      "onboardingBlinkCount": 1,
      "menuBar": {
        "listeningFrameSeconds": 0.525,
        "processingFrameSeconds": 0.15
      }
    }
  },
  "mark": {
    "unit": "brandUnit",
    "cursor": { "x": 0, "y": 0, "width": 10, "height": 46, "cornerRadius": 5 },
    "gap": 6,
    "baseline": { "x": 0, "y": 52, "width": 36, "height": 9, "cornerRadius": 4.5 },
    "size": { "width": 36, "height": 61 },
    "small": {
      "belowPixelHeight": 32,
      "cursorWidth": 13,
      "baselineHeight": 12,
      "gap": 5
    },
    "clearSpace": "cursorWidth",
    "minimumHeightPixels": 12,
    "minimumAppIconPixels": 16
  },
  "wordmark": {
    "text": "Lerro",
    "firstLetter": "mark",
    "rest": { "text": "erro", "source": "Inter 4.1 SemiBold", "form": "outlinedPaths", "fontDistributed": false }
  },
  "menuBar": {
    "pointSize": 18,
    "template": true,
    "frames": ["Idle", "Listening", "ListeningDim", "Processing1", "Processing2", "Processing3", "Processing4", "Error"],
    "geometry": {
      "cursor": { "x": 4, "y": 2, "width": 3, "height": 10, "cornerRadius": 1.5 },
      "baseline": { "x": 4, "y": 13.5, "width": 10, "height": 2.5, "cornerRadius": 1.25 },
      "errorCursor": { "x": 4, "y": 2, "width": 3, "height": 6.5, "cornerRadius": 1.5 },
      "errorDot": { "cx": 5.5, "cy": 10.8, "r": 1.5 }
    }
  }
