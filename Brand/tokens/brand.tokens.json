    "selection": { "alias": "fillSelected" },
    "success": {
      "semantic": "systemGreen",
      "preview": { "light": "#34C759", "dark": "#30D158" }
    },
    "warning": {
      "semantic": "systemOrange",
      "preview": { "light": "#FF9500", "dark": "#FF9F0A" }
