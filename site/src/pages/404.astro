---
import Base from "../layouts/Base.astro";
---
<Base lang="zh" path="/" title="404 — Lerro" description="页面不存在 · Page not found">
  <main class="wrap" style="padding-top:96px;padding-bottom:40px;max-width:640px;text-align:center">
    <h1 style="font-family:var(--serif);font-size:48px;line-height:1.1;letter-spacing:-.03em;font-weight:600">404</h1>
    <p style="margin-top:20px;font-size:18px;color:var(--ink2)">找不到这个页面。</p>
    <p style="margin-top:4px;font-size:18px;color:var(--ink2)">This page does not exist.</p>
    <div style="margin-top:32px;display:flex;gap:12px 26px;align-items:center;justify-content:center;flex-wrap:wrap">
      <a class="btn" href="/">返回首页</a>
      <a class="link" href="/en">Back to home</a>
    </div>
  </main>
</Base>
