---
import "../styles/home.css";
import { home } from "../data/home";
import type { Lang } from "../site";
import Intro from "./home/Intro.astro";
import Story from "./home/Story.astro";
import Apps from "./home/Apps.astro";
import Speed from "./home/Speed.astro";
import Features from "./home/Features.astro";
import Steps from "./home/Steps.astro";
import Pricing from "./home/Pricing.astro";
import Compare from "./home/Compare.astro";
import Privacy from "./home/Privacy.astro";
import Faq from "./home/Faq.astro";
import TryIt from "./home/TryIt.astro";

interface Props {
  lang: Lang;
}
const t = home[Astro.props.lang];
---
<main>
  <Intro t={t.hero} />
  <Story t={t.story} />
  <Apps t={t.apps} />
  <Speed t={t.speed} />
  <Features t={t.features} />
  <Steps t={t.how} />
  <Pricing t={t.price} />
  <Compare t={t.compare} />
  <Privacy t={t.privacy} />
  <Faq t={t.faq} />
  <TryIt t={t.final} />
</main>
