---
import { home } from "../data/home";
import { downloadUrl, localizedPath, type Lang } from "../site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = home[lang].nav;
const root = localizedPath(lang, "/");
---
<nav class="top">
  <a class="logo" href={root} aria-label="Lerro"><b>L</b>erro</a>
  <div class="links">
    <a href={`${root}#how`}>{t.how}</a>
    <a href={`${root}#price`}>{t.price}</a>
    <a href={`${root}#faq`}>{t.faq}</a>
  </div>
  <a class="btn sm" href={downloadUrl}>{t.download}</a>
</nav>
