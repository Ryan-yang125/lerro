---
import { chrome } from "../data/chrome";
import { githubUrl, localizedPath, privacyUrl, type Lang } from "../site";

interface Props {
  lang: Lang;
  path: "/" | "/changelog";
}
const { lang, path } = Astro.props;
const t = chrome[lang].footer;
const other: Lang = lang === "zh" ? "en" : "zh";
---
<footer>
  <div class="wrap">
    <svg class="wordmark" viewBox="-4 -4 172 69" style="color:var(--brand-ink)"><use href="#wm"/></svg>
    <span>© 2026 Lerro</span>
    <div class="links">
      <a href={localizedPath(lang, "/changelog")}>{t.changelog}</a>
      <a href={privacyUrl}>{t.privacy}</a>
      <a href={githubUrl}>GitHub</a>
      <a href={localizedPath(other, path)} hreflang={other === "zh" ? "zh-CN" : "en"}>{t.switchLabel}</a>
    </div>
  </div>
</footer>
