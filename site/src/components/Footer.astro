---
import { chrome } from "../data/chrome";
import { githubUrl, localizedPath, privacyUrl, type Lang } from "../site";

interface Props {
  lang: Lang;
  path: "/" | "/changelog";
}
const { lang, path } = Astro.props;
const t = chrome[lang].footer;
const other: Lang = lang === "zh" ? "en" : "zh";
---
<footer>
  <div class="wrap">
    <span>© 2026 Lerro · <a href={githubUrl}>{t.openSource}</a></span>
    <span class="links">
      <a href={privacyUrl}>{t.privacy}</a><span aria-hidden="true">·</span>
      <a href={localizedPath(lang, "/changelog")}>{t.changelog}</a><span aria-hidden="true">·</span>
      <a href={localizedPath(other, path)} hreflang={other === "zh" ? "zh-CN" : "en"}>{t.switchLabel}</a>
    </span>
    <span class="owners">{t.owners}</span>
  </div>
</footer>
