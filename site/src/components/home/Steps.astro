---
import { demo, type HomeCopy } from "../../data/home";

interface Props {
  t: HomeCopy["how"];
}
const { t } = Astro.props;
---
<section class="how" id="how">
  <div class="wrap">
    <div class="head"><div class="eyebrow">{t.eyebrow}</div><h2 class="big" style="margin-top:8px">{t.h2}</h2><p class="lead">{t.lead}</p></div>
    <div class="st watch">
      <div>
        <div class="num">1</div><h3>{t.steps[0].h3}</h3><p>{t.steps[0].p}</p>
        <div class="ill"><div class="drag"><div class="ic mv"><span><b>L</b></span></div><div class="fold"></div></div></div>
      </div>
      <div>
        <div class="num">2</div><h3>{t.steps[1].h3}</h3><p>{t.steps[1].p}</p>
        <div class="ill"><div class="perm">{t.permissions.map((name) => <div>{name}<span class="sw"></span></div>)}</div></div>
      </div>
      <div>
        <div class="num">3</div><h3>{t.steps[2].h3}</h3><p>{t.steps[2].p}</p>
        <div class="ill"><div class="say"><img src="/apps/wechat.png" alt="" width="22" height="22" loading="lazy" />{demo.sayChip}</div></div>
      </div>
    </div>
    <p class="note">{t.note}</p>
  </div>
</section>

<script>
  import { onView } from "../../scripts/onview";

  onView(".how .watch");
</script>
