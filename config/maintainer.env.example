# Copy to config/maintainer.local.env on an authorized release Mac.
# This file stores labels and paths only. Keep credentials in Keychain/CLI stores.

export LERRO_NOTARY_PROFILE='<notarytool-keychain-profile>'
export LERRO_SPARKLE_KEY_ACCOUNT='app.lerro.mac'
export LERRO_PUBLIC_REPO_DIR='<absolute-path-to-existing-public-repository-worktree>'
export LERRO_PUBLIC_REMOTE='https://github.com/Ryan-yang125/lerro.git'
